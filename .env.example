# ---- Database (required) ----
# PostgreSQL connection string. For production, use a hosted Postgres such as
# Neon (neon.tech), Supabase, or Vercel Postgres. Free tiers work fine for this project.
DATABASE_URL=

# ---- Admin auth (Clerk, Google/Gmail sign-in only) ----
# Get these from your app's dashboard.clerk.com project → API Keys.
# In Clerk Dashboard → User & Authentication: enable the Google connection and
# disable every other sign-in method (email/password, etc.) for this app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated Gmail addresses allowed into /admin. Anyone else who signs in
# via Google gets redirected to /admin/unauthorized.
ADMIN_EMAILS=you@gmail.com,partner@gmail.com

# ---- Customer auth (custom email+password, unrelated to Clerk/admin) ----
# Long random string used to sign customer session JWTs.
CUSTOMER_SESSION_SECRET=

# ---- Password reset emails (Resend) ----
# Sign up free at resend.com → API Keys. Free tier: 3,000 emails/month, 100/day.
# Until you verify your own sending domain in Resend, RESEND_FROM_EMAIL must stay
# "onboarding@resend.dev" and can only deliver to the email you signed up with.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Cassy Shop <onboarding@resend.dev>"

# ---- Image uploads (optional but recommended for production) ----
# Without these, uploaded images fall back to being stored as data URLs directly
# in the database, which works for local development/demo but is NOT recommended
# for production (large payloads, no CDN, no persistence guarantees on some hosts).
# Sign up free at cloudinary.com and paste your values below to enable real uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
